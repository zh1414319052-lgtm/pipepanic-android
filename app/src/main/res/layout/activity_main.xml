<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/display_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pump_bg">

<androidx.drawerlayout.widget.DrawerLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout">
    <!-- The main content view -->

    <LinearLayout xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        tools:context=".MainActivity">

        <WebView
            android:id="@+id/mainWebView"
            android:background="@color/pump_bg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

    </LinearLayout>

    <!-- The navigation drawer -->

    <ScrollView
        android:id="@+id/message_view"
        android:layout_width="300dp"
        android:layout_height="fill_parent"
        android:layout_gravity="start"
        android:background="@drawable/console_drawer"
        android:gravity="start">

        <LinearLayout
            android:id="@+id/message_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="start|center_vertical"
                android:minHeight="52dp"
                android:id="@+id/welcome"
                android:text="@string/welcome"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/primary_text_dark" />


            <Button style="@style/ConsolePrimaryButton"
                android:id="@+id/resume_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="resumeGame"
                android:text="@string/resume"
                android:visibility="gone" />

            <Button style="@style/ConsoleButton"
                android:id="@+id/newgame_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:onClick="newGame"
                android:text="@string/startnewgame"
                android:minHeight="52dp"
                android:enabled="false"
                android:textSize="16sp" />

            <Button style="@style/ConsoleButton"
                android:id="@+id/levels_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:enabled="false"
                android:onClick="openLevels"
                android:text="@string/levels" />

            <TextView
                android:id="@+id/difficultytext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@android:color/primary_text_dark"
                android:gravity="center"
                />

            <SeekBar
                android:id="@+id/difficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:minHeight="48dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_gravity="center"/>






            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/console_drawer"
                >

                <TextView
                    android:id="@+id/battlemodetext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@android:color/primary_text_dark"
                    android:gravity="center"
                    />


                <SeekBar
                    android:id="@+id/battlemodeseed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="99"
                    android:minHeight="48dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                    android:layout_gravity="center"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    >
                    <Button style="@style/ConsoleButton"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:id="@+id/seed_minus"
                        android:text="−"
                        android:contentDescription="@string/decrease_seed"
                        android:gravity="center"
                        android:onClick="decrease_battlemode" />
                    <Button style="@style/ConsoleButton"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:id="@+id/seed_plus"
                        android:layout_marginStart="8dp"
                        android:text="+"
                        android:contentDescription="@string/increase_seed"
                        android:gravity="center"
                        android:onClick="increase_battlemode" />


                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/challenge_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/challenge_hint"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/fullscreen_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:checked="true"
                android:onClick="applyFullScreen"
                android:text="@string/toggle_fullscreen"
                android:textSize="16sp"
                android:textColor="@android:color/primary_text_dark" />

            <Button style="@style/ConsoleButton"
                android:id="@+id/share_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:onClick="shareScreenShot"
                android:text="@string/share_screenshot"
                android:textSize="16sp" />

            <Button style="@style/ConsoleButton"
                android:id="@+id/clear_highscore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/clear_highscore"
                android:onClick="resetHighscore"
                android:textSize="16sp" />

            <Button style="@style/ConsoleButton"
                android:id="@+id/about_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:onClick="showHelp"
                android:text="@string/about"
                android:enabled="false"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
</FrameLayout>
