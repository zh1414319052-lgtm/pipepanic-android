{
  "project": "pipepanic-console-028",
  "revision": 1,
  "designTokens": {
    "bg": "#101D27",
    "panel": "#192B37",
    "well": "#10202B",
    "ink": "#F1F8FA",
    "muted": "#B6CBD4",
    "line": "#5E7A8A",
