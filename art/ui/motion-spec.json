      {
        "id": "game",
        "board": "game",
        "name": "3D 对局",
        "overrides": {}
      },
      {
        "id": "levels",
        "board": "levels",
        "name": "关卡选择",
        "overrides": {}
      },
      {
        "id": "menu",
        "board": "menu",
        "name": "原生菜单",
        "overrides": {}
      }
    ],
    "transitions": [
      {
        "id": "show-levels",
        "name": "show-levels",
        "from": "game",
        "to": "levels",
        "node": "show-levels",
        "trigger": "click",
        "duration": 160,
        "easing": "outCubic",
        "pageEffect": "fade"
      },
      {
        "id": "picker-back",
        "name": "picker-back",
        "from": "levels",
        "to": "game",
        "node": "picker-back",
        "trigger": "click",
        "duration": 160,
        "easing": "outCubic",
        "pageEffect": "fade"
      },
      {
        "id": "level-2",
        "name": "level-2",
        "from": "levels",
        "to": "game",
        "node": "level-2",
        "trigger": "click",
        "duration": 160,
        "easing": "outCubic",
        "pageEffect": "fade"
      },
      {
        "id": "show-menu",
        "name": "show-menu",
        "from": "game",
        "to": "menu",
        "node": "show-menu",
        "trigger": "click",
        "duration": 160,
        "easing": "outCubic",
        "pageEffect": "fade"
      },
      {
        "id": "drawer-resume",
        "name": "drawer-resume",
        "from": "menu",
        "to": "game",
        "node": "drawer-resume",
        "trigger": "click",
        "duration": 160,
        "easing": "outCubic",
        "pageEffect": "fade"
      }
    ]
